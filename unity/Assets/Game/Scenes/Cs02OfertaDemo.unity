MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1752626171}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c8f5392f426603b439eaed09ecc3a4f0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Studio.Game.Cutscenes.CutsceneAOfetaController
  censorVesselActor: {fileID: 1105013857}
  playerLoco: {fileID: 979989417}
  voAudioSource: {fileID: 0}
  lines:
  - lineId: cs02_iria_01
    speaker: Iria (Censor)
    emotion: ameacador-suave
    subtitlePtBr: Devolva minhas reliquias... e devolvo sua irma.
    startSec: 0
    endSec: 6.5
    voClip: {fileID: 8300000, guid: a8ac28fd63a2ef043809bc6d3d104a0b, type: 3}
  - lineId: cs02_dez_01
    speaker: Dez
    emotion: urgente
    subtitlePtBr: Onde voce ta guardando ela?
    startSec: 6.5
    endSec: 10.5
    voClip: {fileID: 8300000, guid: 33943db9e7530964c9e20d09db8fb714, type: 3}
  - lineId: cs02_iria_02
    speaker: Iria (Censor)
    emotion: calmo-persuasivo
    subtitlePtBr: No ultimo segundo intacto da Corona. Traga as reliquias e eu abro
      a caixa.
    startSec: 10.5
    endSec: 17
    voClip: {fileID: 8300000, guid: f4ef5607b8da0604895fac5545847ea0, type: 3}
  - lineId: cs02_porca_01
    speaker: Porca
    emotion: apreensivo
    subtitlePtBr: A voz dela nao tremeu nem meio compasso, Dez.
    startSec: 17
    endSec: 21.5
    voClip: {fileID: 8300000, guid: 016896d41b7071c4eac8f76e1559c6c0, type: 3}
  - lineId: cs02_iria_03
    speaker: Iria (Censor)
    emotion: firme
    subtitlePtBr: Pense bem no que vale mais, Desiderio.
    startSec: 21.5
    endSec: 27
    voClip: {fileID: 8300000, guid: a9800543626b20d4d866a333e246b536, type: 3}
  - lineId: cs02_dez_02
    speaker: Dez
    emotion: contido
    subtitlePtBr: Vamos continuar andando, Porca. Mas eu ouvi cada palavra.
    startSec: 27
    endSec: 32
    voClip: {fileID: 8300000, guid: f45b2ea8b2300cd4c9dc64338ff6c957, type: 3}
